generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users ─────────────────────────────────────────

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  image        String?
  memberships  TeamMember[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// ─── Teams ─────────────────────────────────────────

model Team {
  id          String           @id @default(cuid())
  name        String
  members     TeamMember[]
  teamOkrs    TeamOkr[]
  invitations TeamInvitation[]

  checkInFrequency String?
  checkInDay       String?
  checkInTime      String?

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model TeamMember {
  id            String   @id @default(cuid())
  teamId        String
  userId        String
  role          TeamRole @default(MEMBER)
  dedicationPct Int?
  team          Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([teamId, userId])
}

enum TeamRole {
  OWNER
  MEMBER
}

model TeamInvitation {
  id            String           @id @default(cuid())
  teamId        String
  name          String?
  email         String
  dedicationPct Int?
  invitedById   String
  status        InvitationStatus @default(PENDING)
  team          Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([teamId, email])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

// ─── Team OKR (DB table: TeamCommitment) ───────────

model TeamOkr {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  /// Short scan-friendly label (e.g. “Q1 Growth bet”)
  title          String @default("")
  /// Full team-level outcome statement for this OKR set
  teamObjective  String @default("")

  cycleLabel      String?
  cycleStartDate  DateTime
  cycleEndDate    DateTime

  status    TeamOkrStatus @default(ACTIVE)
  isPrimary Boolean       @default(false)

  completionNotes   String?
  completedAt       DateTime?
  abandonmentReason String?
  abandonedAt       DateTime?

  objectives  Objective[]
  initiatives Initiative[]
  checkIns    GripSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("TeamCommitment")
}

enum TeamOkrStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ABANDONED

  @@map("CommitmentStatus")
}

// ─── Objectives & Key Results ──────────────────────

model Objective {
  id        String  @id @default(cuid())
  teamOkrId String  @map("commitmentId")
  teamOkr   TeamOkr @relation(fields: [teamOkrId], references: [id], onDelete: Cascade)
  title     String
  description String?
  sortOrder Int     @default(0)
  keyResults KeyResult[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamOkrId])
}

model KeyResult {
  id          String    @id @default(cuid())
  objectiveId String
  objective   Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  title       String
  metric      String
  baseline    Float?
  target      Float
  current     Float
  dueDate     DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([objectiveId])
}

// ─── Initiatives (belong to TeamOkr) ───────────────

model Initiative {
  id               String           @id @default(cuid())
  teamOkrId        String           @map("commitmentId")
  teamOkr          TeamOkr          @relation(fields: [teamOkrId], references: [id], onDelete: Cascade)
  name             String
  hypothesis       String
  expectedImpact   Json?
  status           InitiativeStatus @default(NOT_STARTED)
  conclusionReason String?
  conclusionImpact String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

enum InitiativeStatus {
  NOT_STARTED
  IN_PROGRESS
  CONCLUDED
}

// ─── GRIP Sessions (belong to TeamOkr) ─────────────

model GripSession {
  id           String  @id @default(cuid())
  teamOkrId    String  @map("commitmentId")
  teamOkr      TeamOkr @relation(fields: [teamOkrId], references: [id], onDelete: Cascade)

  occurredAt           DateTime
  confidence           Confidence
  confidenceReason     String?
  keyResultSnapshots   Json
  resultsReflection    String
  initiativeReflection String?
  issues               String
  planForward          String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Confidence {
  HIGH
  MEDIUM
  LOW
}
